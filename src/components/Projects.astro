---
// Projects.astro
---

<section id="proyectos" class="py-20 bg-black">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Proyectos Destacados
        </h2>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          Una selección de proyectos que demuestran mis habilidades técnicas y creatividad
        </p>
      </div>

      <!-- Projects Carousel/Grid -->
      <div class="space-y-12">
        <!-- Project 1 -->
        <div class="project-card group">
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class="order-2 lg:order-1">
              <div class="space-y-6">
                <div class="flex items-center gap-3">
                  <span class="text-sm font-medium text-gray-500 bg-gray-900 px-3 py-1 rounded-full">
                    Destacado
                  </span>
                  <span class="text-sm text-gray-400">2024</span>
                </div>
                
                <h3 class="text-2xl md:text-3xl font-bold text-white">
                  E-commerce Platform
                </h3>
                
                <p class="text-gray-400 text-lg leading-relaxed">
                  Plataforma de comercio electrónico completa desarrollada con React y Node.js. 
                  Incluye carrito de compras, sistema de pagos, panel administrativo y gestión 
                  de inventario en tiempo real.
                </p>

                <div class="flex flex-wrap gap-2">
                  <span class="tech-tag">React</span>
                  <span class="tech-tag">Node.js</span>
                  <span class="tech-tag">MongoDB</span>
                  <span class="tech-tag">Stripe</span>
                  <span class="tech-tag">Tailwind CSS</span>
                </div>

                <div class="flex gap-4 pt-4">
                  <a 
                    href="#" 
                    class="flex items-center gap-2 text-white hover:text-gray-300 transition-colors font-medium"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Ver Demo
                  </a>
                  <a 
                    href="#" 
                    class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors font-medium"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    Código
                  </a>
                </div>
              </div>
            </div>
            
            <div class="order-1 lg:order-2">
              <div class="project-image-container group-hover:scale-105 transition-transform duration-300">
                <div class="bg-gradient-to-br from-gray-800 to-gray-900 rounded-lg p-8 aspect-video flex items-center justify-center">
                  <div class="text-center">
                    <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center mx-auto mb-4">
                      <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                      </svg>
                    </div>
                    <p class="text-gray-400 text-sm">Imagen del proyecto</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 2 -->
        <div class="project-card group">
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class="order-1">
              <div class="project-image-container group-hover:scale-105 transition-transform duration-300">
                <div class="bg-gradient-to-br from-blue-900 to-purple-900 rounded-lg p-8 aspect-video flex items-center justify-center">
                  <div class="text-center">
                    <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center mx-auto mb-4">
                      <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
                      </svg>
                    </div>
                    <p class="text-gray-400 text-sm">Dashboard Analytics</p>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="order-2">
              <div class="space-y-6">
                <div class="flex items-center gap-3">
                  <span class="text-sm text-gray-400">2024</span>
                </div>
                
                <h3 class="text-2xl md:text-3xl font-bold text-white">
                  Analytics Dashboard
                </h3>
                
                <p class="text-gray-400 text-lg leading-relaxed">
                  Dashboard interactivo para visualización de datos con gráficos dinámicos, 
                  métricas en tiempo real y reportes personalizables. Construido con 
                  tecnologías modernas para garantizar rendimiento óptimo.
                </p>

                <div class="flex flex-wrap gap-2">
                  <span class="tech-tag">Next.js</span>
                  <span class="tech-tag">TypeScript</span>
                  <span class="tech-tag">Chart.js</span>
                  <span class="tech-tag">PostgreSQL</span>
                  <span class="tech-tag">Prisma</span>
                </div>

                <div class="flex gap-4 pt-4">
                  <a 
                    href="#" 
                    class="flex items-center gap-2 text-white hover:text-gray-300 transition-colors font-medium"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Ver Demo
                  </a>
                  <a 
                    href="#" 
                    class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors font-medium"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    Código
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 3 -->
        <div class="project-card group">
          <div class="grid lg:grid-cols-2 gap-8 items-center">
            <div class="order-2 lg:order-1">
              <div class="space-y-6">
                <div class="flex items-center gap-3">
                  <span class="text-sm text-gray-400">2023</span>
                </div>
                
                <h3 class="text-2xl md:text-3xl font-bold text-white">
                  Task Management App
                </h3>
                
                <p class="text-gray-400 text-lg leading-relaxed">
                  Aplicación de gestión de tareas colaborativa con funciones de tiempo real, 
                  asignación de equipos, seguimiento de progreso y notificaciones automáticas. 
                  Diseñada para mejorar la productividad empresarial.
                </p>

                <div class="flex flex-wrap gap-2">
                  <span class="tech-tag">React</span>
                  <span class="tech-tag">Socket.io</span>
                  <span class="tech-tag">Express</span>
                  <span class="tech-tag">MongoDB</span>
                  <span class="tech-tag">JWT</span>
                </div>

                <div class="flex gap-4 pt-4">
                  <a 
                    href="#" 
                    class="flex items-center gap-2 text-white hover:text-gray-300 transition-colors font-medium"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Ver Demo
                  </a>
                  <a 
                    href="#" 
                    class="flex items-center gap-2 text-gray-400 hover:text-white transition-colors font-medium"
                  >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                    Código
                  </a>
                </div>
              </div>
            </div>
            
            <div class="order-1 lg:order-2">
              <div class="project-image-container group-hover:scale-105 transition-transform duration-300">
                <div class="bg-gradient-to-br from-green-900 to-teal-900 rounded-lg p-8 aspect-video flex items-center justify-center">
                  <div class="text-center">
                    <div class="w-16 h-16 bg-white rounded-lg flex items-center justify-center mx-auto mb-4">
                      <svg class="w-8 h-8 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>
                      </svg>
                    </div>
                    <p class="text-gray-400 text-sm">Task Management</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- More Projects Button -->
      <div class="text-center mt-16">
        <a 
          href="https://github.com/tu-usuario" 
          target="_blank"
          class="inline-flex items-center gap-2 px-8 py-4 border border-gray-600 text-gray-300 font-medium rounded-lg hover:bg-gray-800 hover:text-white transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
