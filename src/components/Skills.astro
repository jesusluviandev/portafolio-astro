<section id="skills" class="py-20 bg-gray-950">
  <div class="container mx-auto px-6">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Skills & Tecnologías
        </h2>
        <p
          class="text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed tracking-wide"
        >
          Las herramientas que me acompañan hoy en la creación de experiencias
          digitales, siempre explorando nuevas tecnologías.
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        {
          skills.map((skill) => (
            <div class="skill-card group">
              <div class="skill-icon">
                <div class="w-12 h-12" set:html={skill.svg} />
              </div>
              <h3 class="skill-title">{skill.name}</h3>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .skill-card {
    @reference bg-gray-900 p-6 rounded-lg flex flex-col items-center justify-center text-center border border-gray-800 transition-all duration-300;
  }
  .skill-card:hover {
    @reference transform -translate-y-2 border-cyan-500 shadow-lg shadow-cyan-500/10;
  }

  /* ESTILO GRISÁCEO POR DEFECTO */
  .skill-icon {
    /* Aquí se define el color gris para los íconos */
    @reference text-gray-400 mb-4 transition-colors duration-300;
  }

  /* EFECTO HOVER */
  .skill-card:hover .skill-icon {
    /* Al pasar el mouse, el color del ícono cambia a cyan */
    @reference text-cyan-400;
  }

  .skill-title {
    @reference text-white font-semibold text-lg;
  }
</style>
