<style>
  /* Hamburger Menu Animation */
  .hamburger-menu {
    position: relative;
    width: 20px;
    height: 16px;
  }
  
  .hamburger-line {
    display: block;
    position: absolute;
    width: 100%;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    transform-origin: center;
  }
  
  .hamburger-line-1 {
    top: 0;
  }
  
  .hamburger-line-2 {
    top: 50%;
    transform: translateY(-50%);
  }
  
  .hamburger-line-3 {
    bottom: 0;
  }
  
  /* When menu is open */
  .menu-open .hamburger-line-1 {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  
  .menu-open .hamburger-line-2 {
    opacity: 0;
    transform: translateY(-50%) scale(0);
  }
  
  .menu-open .hamburger-line-3 {
    bottom: 50%;
    transform: translateY(50%) rotate(-45deg);
  }
  
  /* Mobile Menu Animation */
  .mobile-menu {
    max-height: 0;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .mobile-menu.menu-open {
    max-height: 400px; /* Ajusta según el contenido */
  }
  
  .mobile-menu-content {
    transform: translateY(-20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) 0.1s;
  }
  
  .mobile-menu.menu-open .mobile-menu-content {
    transform: translateY(0);
    opacity: 1;
  }
  
  /* Animación de enlaces del menú */
  .mobile-link {
    transform: translateX(-20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .mobile-menu.menu-open .mobile-link {
    transform: translateX(0);
    opacity: 1;
  }
  
  /* Retrasos escalonados para los enlaces */
  .mobile-menu.menu-open .mobile-link:nth-child(1) { transition-delay: 0.1s; }
  .mobile-menu.menu-open .mobile-link:nth-child(2) { transition-delay: 0.15s; }
  .mobile-menu.menu-open .mobile-link:nth-child(3) { transition-delay: 0.2s; }
  .mobile-menu.menu-open .mobile-link:nth-child(4) { transition-delay: 0.25s; }
  .mobile-menu.menu-open .mobile-link:nth-child(5) { transition-delay: 0.3s; }
  
  /* Animación de iconos sociales */
  .mobile-menu .flex:last-child {
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) 0.35s;
  }
  
  .mobile-menu.menu-open .flex:last-child {
    transform: translateY(0);
    opacity: 1;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mobileMenuButton = document.getElementById("mobile-menu-button");
    const mobileMenu = document.getElementById("mobile-menu");
    let isMenuOpen = false;

    const toggleMenu = () => {
      isMenuOpen = !isMenuOpen;
      
      if (isMenuOpen) {
        // Abrir menú
        mobileMenuButton?.classList.add("menu-open");
        mobileMenu?.classList.add("menu-open");
        mobileMenuButton?.setAttribute("aria-label", "Cerrar menú");
        document.body.style.overflow = "hidden"; // Prevenir scroll
      } else {
        // Cerrar menú
        mobileMenuButton?.classList.remove("menu-open");
        mobileMenu?.classList.remove("menu-open");
        mobileMenuButton?.setAttribute("aria-label", "Abrir menú");
        document.body.style.overflow = ""; // Restaurar scroll
      }
    };

    mobileMenuButton?.addEventListener("click", toggleMenu);

    // Cerrar menú cuando se hace click en un enlace
    const mobileLinks = mobileMenu?.querySelectorAll("a");
    mobileLinks?.forEach((link) => {
      link.addEventListener("click", () => {
        if (isMenuOpen) {
          toggleMenu();
        }
      });
    });

    // Cerrar menú con tecla Escape
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isMenuOpen) {
        toggleMenu();
      }
    });

    // Cerrar menú al hacer click fuera de él
    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (isMenuOpen && 
          !mobileMenu?.contains(target) && 
          !mobileMenuButton?.contains(target)) {
        toggleMenu();
      }
    });
  });
</script>