---
// Hero.astro
---

<section
  class="min-h-screen flex items-center justify-center relative overflow-hidden pt-25 md:pt-25 pb-15 md:pt-0"
>
  <div
    class="absolute inset-0 bg-gradient-to-br from-black via-gray-900 to-black opacity-90"
  >
  </div>

  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <div class="mb-8">
        <div
          class="w-32 h-32 mx-auto rounded-full bg-gradient-to-r from-white to-gray-300 p-1"
        >
          <div
            class="w-full h-full rounded-full bg-gray-800 flex items-center justify-center"
          >
            <span class="text-4xl font-bold text-white">JL</span>
          </div>
        </div>
      </div>

      <div class="space-y-6 animate-fade-in">
        <h1 class="text-5xl md:text-7xl font-bold leading-tight">
          <span class="block text-white">Hey, soy</span>
          <span
            id="typing-effect"
            class="block bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent"
          >
            Jesús Luvian
          </span>
        </h1>

        <p
          class="text-xl md:text-2xl text-white max-w-2xl mx-auto leading-relaxed tracking-wide"
        >
          Desarrollador Full Stack
        </p>

        <p
          class="text-lg text-gray-300 max-w-3xl mx-auto leading-relaxed tracking-wide"
        >
          Apasionado por el desarrollo de soluciones digitales que aporten
          valor, ya sea creando nuevas aplicaciones, optimizando procesos o
          brindando soporte a proyectos en curso. Con experiencia en diversas
          tecnologías modernas y siempre abierto a aprender, colaborar y
          enfrentar nuevos desafíos para impulsar el crecimiento y éxito de cada
          equipo y organización.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center pt-8">
          <a
            href="#skills"
            class="px-8 py-4 bg-white text-black font-medium rounded-lg hover:bg-gray-200 transition-all duration-300 hover:scale-105"
          >
            Ver Skills
          </a>
          <a
            href="#contacto"
            class="px-8 py-4 border border-white text-white font-medium rounded-lg hover:bg-white hover:text-black transition-all duration-300"
          >
            Contáctame
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }

  /* --- NUEVO CSS PARA EL CURSOR --- */
  /* El cursor se añade como un pseudo-elemento ::after */
  #typing-effect::after {
    content: "|";
    /* El gradiente no se puede heredar, así que le ponemos un color fijo */
    color: #a0aec0; /* Un gris de Tailwind (gray-400) */
    animation: blink 1s step-end infinite;
    margin-left: 0.25rem; /* Un pequeño espacio */
  }

  /* Animación para el parpadeo del cursor */
  @keyframes blink {
    from,
    to {
      color: transparent;
    }
    50% {
      color: #a0aec0;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Seleccionamos el elemento que tendrá el efecto
    const typingElement = document.getElementById("typing-effect");
    if (!typingElement) return;

    // Texto que se va a animar
    const textToAnimate = "Jesús Luvian";

    // Parámetros de la animación
    const typingSpeed = 150; // Velocidad de escritura (ms)
    const deletingSpeed = 100; // Velocidad de borrado (ms)
    const delayAfterTyping = 2500; // Pausa después de escribir todo (ms)
    const delayAfterDeleting = 500; // Pausa después de borrar todo (ms)

    let charIndex = textToAnimate.length; // Empezamos con el texto completo
    let isDeleting = true; // La primera acción será borrar

    function typeEffect() {
      // Obtenemos el texto actual basado en el índice
      const currentText = textToAnimate.substring(0, charIndex);

      if (typingElement) typingElement.textContent = currentText;

      // Lógica para decidir si borrar o escribir
      if (isDeleting) {
        // Si estamos borrando, decrementamos el índice
        charIndex--;
      } else {
        // Si estamos escribiendo, incrementamos el índice
        charIndex++;
      }

      // Lógica para cambiar de estado (de borrar a escribir y viceversa)
      if (charIndex < 0) {
        // Si ya se borró todo
        isDeleting = false;
        charIndex = 0;
        // Esperamos un poco antes de empezar a escribir
        setTimeout(typeEffect, delayAfterDeleting);
        return;
      } else if (charIndex > textToAnimate.length) {
        // Si ya se escribió todo
        isDeleting = true;
        charIndex = textToAnimate.length;
        // Esperamos un buen rato con el texto completo antes de volver a borrar
        setTimeout(typeEffect, delayAfterTyping);
        return;
      }

      // Llamada recursiva con el tiempo correspondiente
      const speed = isDeleting ? deletingSpeed : typingSpeed;
      setTimeout(typeEffect, speed);
    }

    // Iniciar la animación después de una pausa inicial para que el texto sea visible
    setTimeout(typeEffect, delayAfterTyping);
  });
</script>
